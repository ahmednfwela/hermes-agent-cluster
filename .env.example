# Xiaomi MiMo API Key
XIAOMI_API_KEY=your-xiaomi-api-key-here
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Peer-token HMAC-SHA256 auth (P1.2)
# PEER_TOKEN: this node's outgoing token
# PEER_TOKENS: comma-separated nodeId:token pairs for verifying peers
# IMPORTANT: a node's own id MUST be in its own PEER_TOKENS map, or its
# single-process self-calls (e.g. plugin→server in the same process) 401.
# Example: PEER_TOKEN=local_secret PEER_TOKENS=local_node:local_secret,peer_b:peer_b_secret
PEER_TOKEN=
PEER_TOKENS=

# GitLab intake webhook secret (X-Gitlab-Token header validation)
GITLAB_INTAKE_WEBHOOK_SECRET=
